{
  "name": "spkm/isams",
  "description": "A PHP wrapper for using iSAMS public REST API",
  "license": "MIT",
  "keywords": [
    "isams",
    "api",
    "rest",
    "laravel"
  ],
  "authors": [
    {
      "name": "Simon Mitchell",
      "email": "spkm@cranleigh.org",
      "role": "Lead Developer"
    },
    {
      "name": "Fred Bradley",
      "email": "frb@cranleigh.org",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^7||^8.0",
    "illuminate/http": "~12||~13",
    "illuminate/support": "~12||~13",
    "intervention/image": "^4.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0 || ^12.0 || ^13.0",
    "laravel/pint": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "spkm\\isams\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "spkm\\isams\\IsamsServiceProvider"
      ],
      "aliases": {
        "Isams": "spkm\\isams\\Facades\\Isams"
      }
    }
  },
  "suggest": {
    "laravel/framework": "The Laravel Framework."
  },
  "autoload-dev": {
    "psr-4": {
      "spkm\\isams\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
    "pint": "vendor/bin/pint",
    "sip-pint": "vendor/bin/pint --test"
  },
  "config": {
    "sort-packages": true
  }
}
